# Required
OPENAI_API_KEY=
# A wallet on Base mainnet holding a little USDC (for the data, about $0.01 per call)
# and a little ETH (for the deployment gas, well under $0.01).
PRIVATE_KEY=

# Optional
## Base RPC endpoint (default https://mainnet.base.org)
RPC_URL=
## Any OpenAI-compatible base URL, e.g. https://agent402.tools/v1/metered with a prepaid credits key
OPENAI_BASE_URL=
## Model name (default gpt-4o-mini)
LLM_MODEL=
